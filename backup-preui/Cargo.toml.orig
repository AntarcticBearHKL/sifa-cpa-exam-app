[package]
name = "studyapp"
version = "0.1.0"
edition = "2021"
description = "法考 / 注会 native study helper (CMF data) + stdio MCP server"

[lib]
name = "studyapp"
path = "src/lib.rs"

[[bin]]
name = "studyapp"
path = "src/bin/studyapp.rs"

[[bin]]
name = "studyapp-mcp"
path = "src/bin/studyapp-mcp.rs"

[dependencies]
# eframe 0.36.2 -> egui 0.36.2 (native window, no web view)
eframe = "0.36.2"
egui = "0.36.2"
# egui_commonmark 0.25.0 is built against egui ^0.36.0 (supports GFM tables)
egui_commonmark = "0.25.0"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[profile.release]
opt-level = 3
