//! `studyapp` — native Windows desktop GUI (eframe/egui, no web view).
//!
//! Two tabs: 学习 (one knowledge-point card at a time) and 做题 (practice).
//! Writes `state/current.json` on every change so the MCP server can read it.
#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]

use std::collections::HashSet;
use std::path::{Path, PathBuf};
use std::sync::Arc;

use eframe::egui;
use egui::{Color32, RichText};
use egui_commonmark::{CommonMarkCache, CommonMarkViewer};

use studyapp::{
    current_json_path, domain_root, load_subject, load_wrong_ids, now_iso, parse_cli_args,
    resolve_state_dir, save_wrong_ids, write_current, CurrentContext, Domain, KnowledgePoint,
    Question, StateKp, StateOption, StateQuestion, SubjectFile, SummarySubject,
};

const APP_TITLE: &str = "法考 · 注会 学习助手";
const CORRECT: Color32 = Color32::from_rgb(21, 128, 61);
const WRONG: Color32 = Color32::from_rgb(185, 28, 28);
const ACCENT: Color32 = Color32::from_rgb(37, 99, 235);
const MUTED: Color32 = Color32::from_rgb(110, 110, 110);

#[derive(PartialEq, Eq, Clone, Copy)]
enum Tab {
    Learn,
    Practice,
}

#[derive(PartialEq, Eq, Clone, Copy)]
enum QKind {
    All,
    Choice,
    Memory,
}

#[derive(PartialEq, Eq, Clone, Copy)]
enum OrderMode {
    Sequential,
    Random,
}

#[derive(Default)]
struct DomainData {
    subjects: Vec<SummarySubject>,
    error: Option<String>,
}

struct App {
    law_root: PathBuf,
    cpa_root: PathBuf,
    state_dir: PathBuf,

    law: DomainData,
    cpa: DomainData,

    domain: Domain,
    tab: Tab,

    subject_id: String,
    subject_name: String,
    subject: Option<Arc<SubjectFile>>,
    subject_error: Option<String>,

    /// title -> index into `subject.knowledge_points` (first match wins).
    kp_title_map: std::collections::HashMap<String, usize>,
    /// lowercased search haystacks, one per KP.
    kp_hay: Vec<String>,
    /// distinct chapters, first-seen order.
    chapters: Vec<String>,

    // learn
    kp_query: String,
    kp_sel: usize,
    kp_scroll_top: bool,

    // practice
    q_kind: QKind,
    q_chapter: Option<String>,
    q_only_wrong: bool,
    q_order_mode: OrderMode,
    order: Vec<usize>,
    q_pos: usize,
    single_sel: Option<String>,
    multi_sel: Vec<String>,
    submitted: bool,
    shown_answer: bool,

    answered: usize,
    correct: usize,
    wrong_ids: HashSet<String>,
    rand_seed: u64,

    md_cache: CommonMarkCache,
    font_used: Option<String>,
    font_warn: Option<String>,
    dirty: bool,
}

impl App {
    fn new(cc: &eframe::CreationContext<'_>) -> Self {
        let args = parse_cli_args();
        let law_root = domain_root(Domain::Law, &args);
        let cpa_root = domain_root(Domain::Cpa, &args);
        let state_dir = resolve_state_dir(args.state_dir.as_deref());

        // CJK font
        let (font_used, font_warn) = install_fonts(&cc.egui_ctx);
        cc.egui_ctx.set_visuals(egui::Visuals::light());

        let law = load_domain_data(&law_root);
        let cpa = load_domain_data(&cpa_root);

        let domain = if !law.subjects.is_empty() {
            Domain::Law
        } else if !cpa.subjects.is_empty() {
            Domain::Cpa
        } else {
            Domain::Law
        };

        let seed = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .map(|d| d.as_nanos() as u64)
            .unwrap_or(12345);

        let mut app = App {
            law_root,
            cpa_root,
            state_dir,
            law,
            cpa,
            domain,
            tab: match std::env::var("CMF_START_TAB")
                .unwrap_or_default()
                .trim()
                .to_ascii_lowercase()
                .as_str()
            {
                "practice" => Tab::Practice,
                _ => Tab::Learn,
            },
            subject_id: String::new(),
            subject_name: String::new(),
            subject: None,
            subject_error: None,
            kp_title_map: std::collections::HashMap::new(),
            kp_hay: Vec::new(),
            chapters: Vec::new(),
            kp_query: String::new(),
            kp_sel: 0,
            kp_scroll_top: true,
            q_kind: QKind::All,
            q_chapter: None,
            q_only_wrong: false,
            q_order_mode: OrderMode::Sequential,
            order: Vec::new(),
            q_pos: 0,
            single_sel: None,
            multi_sel: Vec::new(),
            submitted: false,
            shown_answer: false,
            answered: 0,
            correct: 0,
            wrong_ids: HashSet::new(),
            rand_seed: seed,
            md_cache: CommonMarkCache::default(),
            font_used,
            font_warn,
            dirty: true,
        };

        // Initial subject selection.
        let subs = app.data(app.domain).subjects.clone();
        if let Some(first) = subs.first() {
            app.subject_id = first.id.clone();
        }
        app.reload_subject();
        app
    }

    fn data(&self, d: Domain) -> &DomainData {
        match d {
            Domain::Law => &self.law,
            Domain::Cpa => &self.cpa,
        }
    }

    fn root(&self, d: Domain) -> &Path {
        match d {
            Domain::Law => &self.law_root,
            Domain::Cpa => &self.cpa_root,
        }
    }

    // ------------------------------------------------------------------
    // Loading
    // ------------------------------------------------------------------

    fn set_domain(&mut self, d: Domain) {
        self.domain = d;
        let subs = self.data(d).subjects.clone();
        if !subs.iter().any(|s| s.id == self.subject_id) {
            self.subject_id = subs.first().map(|s| s.id.clone()).unwrap_or_default();
        }
        self.reload_subject();
    }

    fn reload_subject(&mut self) {
        self.subject = None;
        self.subject_error = None;
        self.subject_name.clear();
        self.kp_title_map.clear();
        self.kp_hay.clear();
        self.chapters.clear();
        self.kp_sel = 0;
        self.kp_query.clear();
        self.reset_answer();
        self.answered = 0;
        self.correct = 0;
        self.q_chapter = None;
        self.order.clear();
        self.q_pos = 0;

        if self.subject_id.is_empty() {
            self.dirty = true;
            return;
        }

        let root = self.root(self.domain).to_path_buf();
        match load_subject(&root, &self.subject_id) {
            Ok(sf) => {
                let s = Arc::new(sf);
                self.subject_name = if s.name.is_empty() {
                    self.data(self.domain)
                        .subjects
                        .iter()
                        .find(|x| x.id == self.subject_id)
                        .map(|x| x.name.clone())
                        .unwrap_or_default()
                } else {
                    s.name.clone()
                };

                for (i, kp) in s.knowledge_points.iter().enumerate() {
                    self.kp_title_map.entry(kp.title.clone()).or_insert(i);
                }
                self.kp_hay = s
                    .knowledge_points
                    .iter()
                    .map(|kp| {
                        format!(
                            "{}\n{}\n{}\n{}",
                            kp.title,
                            kp.chapter.clone().unwrap_or_default(),
                            kp.summary.clone().unwrap_or_default(),
                            kp.tags.join(" ")
                        )
                        .to_lowercase()
                    })
                    .collect();

                let mut seen = HashSet::new();
                for q in &s.questions {
                    let c = q.chapter_label();
                    if seen.insert(c.clone()) {
                        self.chapters.push(c);
                    }
                }

                self.wrong_ids = load_wrong_ids(&self.state_dir, self.domain, &self.subject_id)
                    .into_iter()
                    .collect();
                self.subject = Some(s);
            }
            Err(e) => {
                self.subject_error = Some(e);
                self.wrong_ids.clear();
            }
        }

        self.build_order();
        self.dirty = true;
    }

    fn build_order(&mut self) {
        let Some(subject) = self.subject.clone() else {
            self.order.clear();
            self.q_pos = 0;
            return;
        };
        let mut idx: Vec<usize> = (0..subject.questions.len())
            .filter(|&i| {
                let q = &subject.questions[i];
                let kind_ok = match self.q_kind {
                    QKind::All => true,
                    QKind::Choice => q.is_choice(),
                    QKind::Memory => !q.is_choice(),
                };
                let chapter_ok = match &self.q_chapter {
                    None => true,
                    Some(c) => &q.chapter_label() == c,
                };
                let wrong_ok = !self.q_only_wrong || self.wrong_ids.contains(&q.id);
                kind_ok && chapter_ok && wrong_ok
            })
            .collect();

        if self.q_order_mode == OrderMode::Random {
            shuffle(&mut idx, self.rand_seed);
        }

        self.order = idx;
        self.q_pos = 0;
        self.reset_answer();
    }

    fn reset_answer(&mut self) {
        self.single_sel = None;
        self.multi_sel.clear();
        self.submitted = false;
        self.shown_answer = false;
    }

    // ------------------------------------------------------------------
    // Derived accessors
    // ------------------------------------------------------------------

    fn filtered_kp_indices(&self) -> Vec<usize> {
        let Some(s) = &self.subject else {
            return Vec::new();
        };
        let q = self.kp_query.trim().to_lowercase();
        if q.is_empty() {
            return (0..s.knowledge_points.len()).collect();
        }
        (0..s.knowledge_points.len())
            .filter(|&i| self.kp_hay.get(i).map_or(false, |h| h.contains(&q)))
            .collect()
    }

    fn current_kp<'a>(&self, subject: &'a SubjectFile) -> Option<&'a KnowledgePoint> {
        let f = self.filtered_kp_indices();
        if f.is_empty() {
            return None;
        }
        let pos = self.kp_sel.min(f.len() - 1);
        subject.knowledge_points.get(f[pos])
    }

    fn current_question<'a>(&self, subject: &'a SubjectFile) -> Option<&'a Question> {
        let qi = *self.order.get(self.q_pos)?;
        subject.questions.get(qi)
    }

    // ------------------------------------------------------------------
    // Actions
    // ------------------------------------------------------------------

    fn submit(&mut self) {
        let Some(subject) = self.subject.clone() else {
            return;
        };
        let Some(q) = self.current_question(&subject).cloned() else {
            return;
        };
        if q.options.is_empty() {
            return;
        }
        let sel: Vec<String> = if q.is_multi() {
            self.multi_sel.clone()
        } else {
            self.single_sel.clone().into_iter().collect()
        };
        if sel.is_empty() {
            return;
        }
        let ok = q.grade(&sel);
        self.submitted = true;
        self.answered += 1;
        if ok {
            self.correct += 1;
            self.wrong_ids.remove(&q.id);
        } else {
            self.wrong_ids.insert(q.id.clone());
        }
        self.persist_wrong();
        if self.q_only_wrong {
            self.build_order();
        }
        self.dirty = true;
    }

    fn self_assess(&mut self, remembered: bool) {
        let Some(subject) = self.subject.clone() else {
            return;
        };
        let Some(q) = self.current_question(&subject).cloned() else {
            return;
        };
        self.answered += 1;
        if remembered {
            self.correct += 1;
            self.wrong_ids.remove(&q.id);
        } else {
            self.wrong_ids.insert(q.id.clone());
        }
        self.persist_wrong();
        self.next_question();
    }

    fn next_question(&mut self) {
        if !self.order.is_empty() {
            self.q_pos = (self.q_pos + 1) % self.order.len();
        }
        self.reset_answer();
        self.dirty = true;
    }

    fn prev_question(&mut self) {
        if !self.order.is_empty() {
            self.q_pos = if self.q_pos == 0 {
                self.order.len() - 1
            } else {
                self.q_pos - 1
            };
        }
        self.reset_answer();
        self.dirty = true;
    }

    fn persist_wrong(&self) {
        let ids: Vec<String> = self.wrong_ids.iter().cloned().collect();
        if let Err(e) = save_wrong_ids(&self.state_dir, self.domain, &self.subject_id, &ids) {
            eprintln!("[studyapp] 写入错题文件失败: {e}");
        }
    }

    /// Jump to the 学习 tab positioned on a given KP index (full list).
    fn jump_to_kp(&mut self, kp_index: usize) {
        self.tab = Tab::Learn;
        self.kp_query.clear();
        self.kp_sel = kp_index; // with an empty query, filtered == full order
        self.kp_scroll_top = true;
        self.dirty = true;
    }

    // ------------------------------------------------------------------
    // state/current.json
    // ------------------------------------------------------------------

    fn build_context(&self) -> CurrentContext {
        let mut c = CurrentContext {
            ts: now_iso(),
            domain: self.domain.id().to_string(),
            tab: match self.tab {
                Tab::Learn => "learn",
                Tab::Practice => "practice",
            }
            .to_string(),
            subject_id: self.subject_id.clone(),
            subject_name: if self.subject_name.is_empty() {
                self.data(self.domain)
                    .subjects
                    .iter()
                    .find(|x| x.id == self.subject_id)
                    .map(|x| x.name.clone())
                    .unwrap_or_default()
            } else {
                self.subject_name.clone()
            },
            question: None,
            knowledge_points: Vec::new(),
        };

        let Some(subject) = &self.subject else {
            return c;
        };

        if self.tab == Tab::Practice {
            if let Some(q) = self.current_question(subject) {
                c.question = Some(state_from_question(q));
                for title in &q.knowledge_points {
                    if let Some(&i) = self.kp_title_map.get(title) {
                        if let Some(kp) = subject.knowledge_points.get(i) {
                            c.knowledge_points.push(state_from_kp(kp));
                        }
                    }
                }
            }
        } else if let Some(kp) = self.current_kp(subject) {
            c.knowledge_points.push(state_from_kp(kp));
        }
        c
    }

    fn flush_state(&mut self) {
        let ctx = self.build_context();
        if let Err(e) = write_current(&self.state_dir, &ctx) {
            eprintln!("[studyapp] 写入 current.json 失败: {e}");
        }
    }

    // ------------------------------------------------------------------
    // Keyboard
    // ------------------------------------------------------------------

    fn handle_keys(&mut self, ctx: &egui::Context) {
        if ctx.egui_wants_keyboard_input() || self.tab != Tab::Learn {
            return;
        }
        let n = self.filtered_kp_indices().len();
        if ctx.input(|i| i.key_pressed(egui::Key::ArrowLeft)) {
            if n > 0 {
                self.kp_sel = self.kp_sel.saturating_sub(1);
                self.kp_scroll_top = true;
                self.dirty = true;
            }
        }
        if ctx.input(|i| i.key_pressed(egui::Key::ArrowRight)) {
            if n > 0 {
                self.kp_sel = (self.kp_sel + 1).min(n - 1);
                self.kp_scroll_top = true;
                self.dirty = true;
            }
        }
    }

    // ------------------------------------------------------------------
    // Panels
    // ------------------------------------------------------------------

    fn top_bar(&mut self, ui: &mut egui::Ui) {
        egui::Panel::top("top").show(ui, |ui| {
            ui.add_space(4.0);
            ui.horizontal_wrapped(|ui| {
                ui.label(RichText::new(APP_TITLE).heading().strong());
                ui.separator();

                for d in Domain::ALL {
                    let sel = self.domain == d;
                    if ui
                        .selectable_label(sel, RichText::new(d.label()).size(15.0).strong())
                        .clicked()
                        && !sel
                    {
                        self.set_domain(d);
                    }
                }

                ui.separator();
                let subjects = self.data(self.domain).subjects.clone();
                let cur_name = subjects
                    .iter()
                    .find(|s| s.id == self.subject_id)
                    .map(|s| s.name.clone())
                    .unwrap_or_else(|| "（无科目）".to_string());
                let before = self.subject_id.clone();
                egui::ComboBox::from_id_salt("subject_combo")
                    .selected_text(cur_name)
                    .width(220.0)
                    .show_ui(ui, |ui| {
                        for s in &subjects {
                            let label = match &s.group {
                                Some(g) if !g.is_empty() => format!("[{}] {}", g, s.name),
                                _ => s.name.clone(),
                            };
                            ui.selectable_value(&mut self.subject_id, s.id.clone(), label);
                        }
                    });
                if self.subject_id != before {
                    self.reload_subject();
                }

                ui.separator();
                if ui
                    .selectable_label(self.tab == Tab::Learn, RichText::new("学习").strong())
                    .clicked()
                {
                    self.tab = Tab::Learn;
                    self.dirty = true;
                }
                if ui
                    .selectable_label(self.tab == Tab::Practice, RichText::new("做题").strong())
                    .clicked()
                {
                    self.tab = Tab::Practice;
                    self.dirty = true;
                }

                ui.separator();
                ui.label(
                    RichText::new(format!(
                        "{} · {} · {}",
                        self.domain.label(),
                        if self.subject_name.is_empty() {
                            "未选择科目"
                        } else {
                            &self.subject_name
                        },
                        match self.tab {
                            Tab::Learn => "学习",
                            Tab::Practice => "做题",
                        }
                    ))
                    .weak(),
                );
            });
            ui.add_space(4.0);
        });
    }

    fn status_bar(&mut self, ui: &mut egui::Ui) {
        egui::Panel::bottom("status").show(ui, |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(
                    RichText::new(format!(
                        "字体: {}   状态文件: {}",
                        self.font_used.clone().unwrap_or_else(|| "（内置字体）".to_string()),
                        current_json_path(&self.state_dir).display()
                    ))
                    .weak()
                    .size(12.0),
                );
                if let Some(w) = &self.font_warn {
                    ui.colored_label(WRONG, RichText::new(w).size(12.0));
                }
                if let Some(e) = &self.subject_error {
                    ui.colored_label(WRONG, RichText::new(e).size(12.0));
                }
                if let Some(e) = &self.data(self.domain).error {
                    ui.colored_label(WRONG, RichText::new(format!("数据加载: {e}")).size(12.0));
                }
            });
        });
    }

    fn left_panel(&mut self, ui: &mut egui::Ui) {
        egui::Panel::left("list_panel")
            .resizable(true)
            .default_size(370.0)
            .min_size(260.0)
            .max_size(560.0)
            .show(ui, |ui| match self.tab {
                Tab::Learn => self.learn_list(ui),
                Tab::Practice => self.practice_filters(ui),
            });
    }

    fn learn_list(&mut self, ui: &mut egui::Ui) {
        ui.add_space(4.0);
        ui.horizontal(|ui| {
            ui.label(RichText::new("搜索").strong());
            ui.add(
                egui::TextEdit::singleline(&mut self.kp_query)
                    .hint_text("标题 / 章节 / 小结")
                    .desired_width(f32::INFINITY),
            );
        });
        let filtered = self.filtered_kp_indices();
        let n = filtered.len();
        if n > 0 && self.kp_sel >= n {
            self.kp_sel = n - 1;
        }

        ui.add_space(4.0);
        ui.horizontal(|ui| {
            if ui
                .add_enabled(self.kp_sel > 0, egui::Button::new("◀ 上一张"))
                .clicked()
            {
                self.kp_sel = self.kp_sel.saturating_sub(1);
                self.kp_scroll_top = true;
                self.dirty = true;
            }
            if ui
                .add_enabled(self.kp_sel + 1 < n, egui::Button::new("下一张 ▶"))
                .clicked()
            {
                self.kp_sel += 1;
                self.kp_scroll_top = true;
                self.dirty = true;
            }
            ui.label(
                RichText::new(if n == 0 {
                    "第 0 / 0 张".to_string()
                } else {
                    format!("第 {} / {} 张", self.kp_sel + 1, n)
                })
                .weak(),
            );
        });

        ui.separator();

        let Some(subject) = self.subject.clone() else {
            ui.label(RichText::new("尚未加载科目。").weak());
            return;
        };

        egui::ScrollArea::vertical()
            .id_salt("kp_list")
            .auto_shrink([false, false])
            .show(ui, |ui| {
                let mut last_chapter: Option<String> = None;
                for (pos, &kpi) in filtered.iter().enumerate() {
                    let kp = &subject.knowledge_points[kpi];
                    let chapter = kp.chapter_label();
                    if last_chapter.as_deref() != Some(chapter.as_str()) {
                        ui.add_space(6.0);
                        ui.label(RichText::new(&chapter).strong().color(ACCENT).size(13.0));
                        last_chapter = Some(chapter);
                    }

                    let selected = pos == self.kp_sel;
                    let row_text = RichText::new(format!("{}. {}", pos + 1, kp.title));
                    let clicked = match kp.frequency_label() {
                        Some(f) => {
                            let resp = ui.horizontal(|ui| {
                                let r = ui.selectable_label(selected, row_text.clone());
                                let badge = match f {
                                    "高频" => RichText::new(f).color(WRONG).size(11.0),
                                    "中频" => RichText::new(f)
                                        .color(Color32::from_rgb(180, 120, 20))
                                        .size(11.0),
                                    _ => RichText::new(f).color(MUTED).size(11.0),
                                };
                                ui.label(badge);
                                r
                            });
                            resp.inner.clicked()
                        }
                        None => ui.selectable_label(selected, row_text).clicked(),
                    };
                    if clicked {
                        self.kp_sel = pos;
                        self.kp_scroll_top = true;
                        self.dirty = true;
                    }
                }
            });
    }

    fn practice_filters(&mut self, ui: &mut egui::Ui) {
        let snapshot = (
            self.q_kind,
            self.q_chapter.clone(),
            self.q_only_wrong,
            self.q_order_mode,
        );
        ui.add_space(4.0);
        ui.label(RichText::new("题型").strong());
        ui.horizontal(|ui| {
            ui.radio_value(&mut self.q_kind, QKind::All, "全部");
            ui.radio_value(&mut self.q_kind, QKind::Choice, "选择题");
            ui.radio_value(&mut self.q_kind, QKind::Memory, "记忆自测");
        });

        ui.add_space(4.0);
        ui.label(RichText::new("章节").strong());
        let chapters = self.chapters.clone();
        let cur = self.q_chapter.clone().unwrap_or_else(|| "全部章节".to_string());
        egui::ComboBox::from_id_salt("chapter_combo")
            .selected_text(cur)
            .width(300.0)
            .show_ui(ui, |ui| {
                if ui.selectable_label(self.q_chapter.is_none(), "全部章节").clicked() {
                    self.q_chapter = None;
                }
                for c in &chapters {
                    let selected = self.q_chapter.as_deref() == Some(c.as_str());
                    if ui.selectable_label(selected, c).clicked() {
                        self.q_chapter = Some(c.clone());
                    }
                }
            });

        ui.add_space(4.0);
        ui.checkbox(&mut self.q_only_wrong, "仅看错题");
        ui.horizontal(|ui| {
            ui.label(RichText::new("顺序").strong());
            ui.radio_value(&mut self.q_order_mode, OrderMode::Sequential, "顺序");
            ui.radio_value(&mut self.q_order_mode, OrderMode::Random, "随机");
        });

        if (self.q_kind, self.q_chapter.clone(), self.q_only_wrong, self.q_order_mode) != snapshot {
            self.build_order();
            self.dirty = true;
        }

        ui.add_space(4.0);
        ui.separator();

        // Stats
        let acc = if self.answered == 0 {
            "—".to_string()
        } else {
            format!("{:.0}%", self.correct as f64 / self.answered as f64 * 100.0)
        };
        ui.horizontal_wrapped(|ui| {
            ui.label(
                RichText::new(if self.order.is_empty() {
                    "第 0 / 0 题".to_string()
                } else {
                    format!("第 {} / {} 题", self.q_pos + 1, self.order.len())
                })
                .strong(),
            );
            ui.separator();
            ui.label(RichText::new(format!("正确率 {acc}")).color(CORRECT));
            ui.separator();
            ui.label(RichText::new(format!("错题 {}", self.wrong_ids.len())).color(WRONG));
        });
        ui.separator();

        let Some(subject) = self.subject.clone() else {
            ui.label(RichText::new("尚未加载科目。").weak());
            return;
        };

        let total = self.order.len();
        egui::ScrollArea::vertical()
            .id_salt("q_list")
            .auto_shrink([false, false])
            .show_rows(ui, 22.0, total, |ui, range| {
                for i in range {
                    let qi = self.order[i];
                    let q = &subject.questions[qi];
                    let selected = i == self.q_pos;
                    let is_choice = q.is_choice();
                    let color = if self.wrong_ids.contains(&q.id) {
                        WRONG
                    } else if is_choice {
                        Color32::from_rgb(40, 40, 40)
                    } else {
                        MUTED
                    };
                    let text = RichText::new(format!("{}. {}", i + 1, q.stem_preview(38)))
                        .color(color)
                        .size(12.5);
                    if ui.selectable_label(selected, text).clicked() {
                        self.q_pos = i;
                        self.reset_answer();
                        self.dirty = true;
                    }
                }
            });
    }

    fn central(&mut self, ui: &mut egui::Ui) {
        egui::CentralPanel::default().show(ui, |ui| match self.tab {
            Tab::Learn => self.learn_card(ui),
            Tab::Practice => self.practice_card(ui),
        });
    }

    fn learn_card(&mut self, ui: &mut egui::Ui) {
        let Some(subject) = self.subject.clone() else {
            ui.centered_and_justified(|ui| {
                ui.label(RichText::new("请选择科目（或检查数据目录）。").weak());
            });
            return;
        };
        let filtered = self.filtered_kp_indices();
        let n = filtered.len();
        if n == 0 {
            ui.add_space(20.0);
            ui.label(RichText::new("没有匹配的知识点。").weak());
            return;
        }
        let pos = self.kp_sel.min(n - 1);
        let kpi = filtered[pos];
        let kp = subject.knowledge_points[kpi].clone();

        let mut sa = egui::ScrollArea::vertical().id_salt("learn_scroll");
        if self.kp_scroll_top {
            sa = sa.vertical_scroll_offset(0.0);
            self.kp_scroll_top = false;
        }
        sa.show(ui, |ui| {
            // Header
            ui.add_space(6.0);
            ui.horizontal_wrapped(|ui| {
                ui.label(RichText::new(&kp.title).heading().strong());
                if let Some(f) = kp.frequency_label() {
                    ui.label(RichText::new(f).color(WRONG).strong().size(13.0));
                }
            });
            ui.label(
                RichText::new(format!(
                    "章节：{}    （第 {} / {} 张）",
                    kp.chapter_label(),
                    pos + 1,
                    n
                ))
                .weak()
                .size(13.0),
            );
            ui.separator();

            // 考点解析 (markdown content)
            ui.label(RichText::new("考点解析").strong().size(16.0));
            match kp.content.as_ref().filter(|s| !s.trim().is_empty()) {
                Some(content) => {
                    CommonMarkViewer::new().show(ui, &mut self.md_cache, content);
                }
                None => {
                    ui.label(RichText::new("（本条知识点无正文）").weak());
                }
            }

            // 记忆口诀
            if let Some(m) = kp.mnemonic.as_ref().filter(|s| !s.trim().is_empty()) {
                ui.add_space(8.0);
                ui.group(|ui| {
                    ui.label(RichText::new("记忆口诀").strong().size(15.0));
                    ui.label(RichText::new(m.trim()).italics());
                });
            }

            // 要点小结
            if let Some(s) = kp.summary.as_ref().filter(|s| !s.trim().is_empty()) {
                ui.add_space(8.0);
                ui.group(|ui| {
                    ui.label(RichText::new("要点小结").strong().size(15.0));
                    ui.label(RichText::new(s.trim()));
                });
            }

            // 来源/出处
            ui.add_space(8.0);
            ui.separator();
            ui.horizontal_wrapped(|ui| {
                ui.label(RichText::new("来源/出处：").strong().size(13.0));
                match &kp.source {
                    Some(src) => {
                        ui.label(RichText::new(src.provenance()).weak().size(13.0));
                        if let Some(u) = src.url.as_ref().filter(|s| !s.is_empty()) {
                            ui.hyperlink_to("🔗 原文", u);
                        }
                    }
                    None => {
                        ui.label(RichText::new("（无出处信息）").weak().size(13.0));
                    }
                }
            });
            ui.add_space(16.0);
        });
    }

    fn practice_card(&mut self, ui: &mut egui::Ui) {
        let Some(subject) = self.subject.clone() else {
            ui.centered_and_justified(|ui| {
                ui.label(RichText::new("请选择科目（或检查数据目录）。").weak());
            });
            return;
        };
        if self.order.is_empty() {
            ui.add_space(20.0);
            ui.centered_and_justified(|ui| {
                ui.label(RichText::new("当前筛选条件下没有题目。").weak());
            });
            return;
        }
        let total = self.order.len();
        let pos = self.q_pos.min(total - 1);
        let qi = self.order[pos];
        let q = subject.questions[qi].clone();

        egui::ScrollArea::vertical()
            .id_salt("practice_scroll")
            .auto_shrink([false, false])
            .show(ui, |ui| {
                // Badges
                ui.add_space(6.0);
                ui.horizontal_wrapped(|ui| {
                    ui.label(
                        RichText::new(q.type_label())
                            .strong()
                            .color(ACCENT)
                            .background_color(Color32::from_rgb(232, 240, 254)),
                    );
                    ui.label(RichText::new(format!("章节：{}", q.chapter_label())).weak());
                    if let Some(y) = q.year_label() {
                        ui.label(RichText::new(format!("年份：{y}")).weak());
                    }
                    ui.label(RichText::new(format!("第 {} / {} 题", pos + 1, total)).strong());
                });
                ui.separator();

                // Stem
                ui.label(RichText::new(q.stem.trim()).size(15.0));
                ui.add_space(6.0);

                if q.is_choice() {
                    self.render_options(ui, &q);

                    ui.add_space(8.0);
                    ui.horizontal(|ui| {
                        let can_submit = !self.submitted
                            && (!self.multi_sel.is_empty() || self.single_sel.is_some());
                        if ui
                            .add_enabled(can_submit, egui::Button::new(RichText::new("提交答案").strong()))
                            .clicked()
                        {
                            self.submit();
                        }
                        if self.submitted {
                            let sel: Vec<String> = if q.is_multi() {
                                self.multi_sel.clone()
                            } else {
                                self.single_sel.clone().into_iter().collect()
                            };
                            let ok = q.grade(&sel);
                            if ok {
                                ui.label(RichText::new("✔ 回答正确").color(CORRECT).strong());
                            } else {
                                ui.label(RichText::new("✘ 回答错误").color(WRONG).strong());
                            }
                            ui.label(
                                RichText::new(format!("正确答案：{}", q.answer.join("、")))
                                    .strong(),
                            );
                        }
                    });

                    if self.submitted {
                        self.render_explanation(ui, &q);
                    }
                } else {
                    // 记忆/自测 card
                    ui.group(|ui| {
                        ui.label(RichText::new("记忆 · 自测").strong().size(15.0));
                        if !self.shown_answer {
                            ui.label(RichText::new("先回想一下，再点击下方按钮核对。").weak());
                            if ui.button("显示答案").clicked() {
                                self.shown_answer = true;
                                self.dirty = true;
                            }
                        } else {
                            if let Some(at) = q.answer_text.as_ref().filter(|s| !s.trim().is_empty()) {
                                ui.label(RichText::new("参考答案").strong());
                                ui.label(RichText::new(at.trim()));
                            }
                            if let Some(exp) = q.explanation.as_ref().filter(|s| !s.trim().is_empty()) {
                                ui.add_space(4.0);
                                ui.label(RichText::new("解析").strong());
                                CommonMarkViewer::new().show(ui, &mut self.md_cache, exp);
                            }
                            if q.answer_text.is_none() && q.explanation.is_none() {
                                ui.label(RichText::new("（本条目无参考答案/解析）").weak());
                            }
                            ui.add_space(6.0);
                            ui.horizontal(|ui| {
                                if ui.button("记住了 ✅").clicked() {
                                    self.self_assess(true);
                                }
                                if ui.button("没记住 ❌").clicked() {
                                    self.self_assess(false);
                                }
                            });
                        }
                    });
                    self.render_related_kps(ui, &q);
                }

                ui.add_space(10.0);
                ui.separator();
                ui.horizontal(|ui| {
                    if ui
                        .add_enabled(self.order.len() > 1, egui::Button::new("◀ 上一题"))
                        .clicked()
                    {
                        self.prev_question();
                    }
                    if ui.button(RichText::new("下一题 ▶").strong()).clicked() {
                        self.next_question();
                    }
                });

                // Provenance for the current question
                ui.add_space(8.0);
                ui.horizontal_wrapped(|ui| {
                    ui.label(RichText::new("来源/出处：").strong().size(13.0));
                    match &q.source {
                        Some(src) => {
                            ui.label(RichText::new(src.provenance()).weak().size(13.0));
                            if let Some(u) = src.url.as_ref().filter(|s| !s.is_empty()) {
                                ui.hyperlink_to("🔗 原文", u);
                            }
                        }
                        None => {
                            ui.label(RichText::new("（无出处信息）").weak().size(13.0));
                        }
                    }
                });
                ui.add_space(16.0);
            });
    }

    fn render_options(&mut self, ui: &mut egui::Ui, q: &Question) {
        let is_multi = q.is_multi();
        let correct: Vec<String> = q
            .answer
            .iter()
            .map(|s| s.trim().to_ascii_uppercase())
            .collect();

        for o in &q.options {
            let selected = if is_multi {
                self.multi_sel.iter().any(|x| x == &o.label)
            } else {
                self.single_sel.as_deref() == Some(o.label.as_str())
            };
            let is_correct = correct.iter().any(|c| c.eq_ignore_ascii_case(&o.label));

            let mut txt = RichText::new(format!("{}. {}", o.label, o.text));
            if self.submitted {
                if is_correct {
                    txt = txt.color(CORRECT).strong();
                } else if selected {
                    txt = txt.color(WRONG);
                }
            } else if selected {
                txt = txt.color(ACCENT).strong();
            }

            if self.submitted {
                ui.label(txt);
            } else if is_multi {
                let mut checked = selected;
                if ui.checkbox(&mut checked, txt).changed() {
                    if checked {
                        if !self.multi_sel.iter().any(|x| x == &o.label) {
                            self.multi_sel.push(o.label.clone());
                        }
                    } else {
                        self.multi_sel.retain(|x| x != &o.label);
                    }
                    self.dirty = true;
                }
            } else {
                let r = ui.radio_value(&mut self.single_sel, Some(o.label.clone()), txt);
                if r.changed() {
                    self.dirty = true;
                }
            }
        }
    }

    fn render_explanation(&mut self, ui: &mut egui::Ui, q: &Question) {
        ui.add_space(8.0);
        ui.separator();
        ui.label(RichText::new("解析").strong().size(16.0));
        match q.explanation.as_ref().filter(|s| !s.trim().is_empty()) {
            Some(exp) => {
                CommonMarkViewer::new().show(ui, &mut self.md_cache, exp);
            }
            None => {
                ui.label(RichText::new("（无解析）").weak());
            }
        }
        self.render_related_kps(ui, q);
    }

    fn render_related_kps(&mut self, ui: &mut egui::Ui, q: &Question) {
        if q.knowledge_points.is_empty() {
            return;
        }
        ui.add_space(8.0);
        ui.label(RichText::new("关联知识点").strong().size(15.0));
        let mut jump: Option<usize> = None;
        ui.horizontal_wrapped(|ui| {
            for title in &q.knowledge_points {
                match self.kp_title_map.get(title) {
                    Some(&kpi) => {
                        if ui
                            .link(RichText::new(format!("📘 {title}")))
                            .on_hover_text("点击切换到「学习」标签并定位到该知识点")
                            .clicked()
                        {
                            jump = Some(kpi);
                        }
                    }
                    None => {
                        ui.label(
                            RichText::new(format!("{title}（未匹配到知识点）"))
                                .weak()
                                .size(12.5),
                        );
                    }
                }
            }
        });
        if let Some(kpi) = jump {
            self.jump_to_kp(kpi);
        }
    }
}

impl eframe::App for App {
    fn ui(&mut self, ui: &mut egui::Ui, _frame: &mut eframe::Frame) {
        let ctx = ui.ctx().clone();
        self.handle_keys(&ctx);
        self.top_bar(ui);
        self.status_bar(ui);
        self.left_panel(ui);
        self.central(ui);

        if self.dirty {
            self.flush_state();
            self.dirty = false;
        }
    }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

fn state_from_question(q: &Question) -> StateQuestion {
    StateQuestion {
        id: q.id.clone(),
        stem: q.stem.clone(),
        type_: q.qtype.clone(),
        type_raw: q.type_raw.clone(),
        chapter: q.chapter.clone(),
        year: if q.year.is_null() {
            None
        } else {
            Some(q.year.clone())
        },
        options: q
            .options
            .iter()
            .map(|o| StateOption {
                label: o.label.clone(),
                text: o.text.clone(),
            })
            .collect(),
        answer: q.answer.clone(),
        answer_text: q.answer_text.clone(),
        explanation: q.explanation.clone(),
        knowledge_points: q.knowledge_points.clone(),
        source: q.source.as_ref().map(|s| s.to_state()).unwrap_or_default(),
    }
}

fn state_from_kp(kp: &KnowledgePoint) -> StateKp {
    StateKp {
        id: kp.id.clone(),
        title: kp.title.clone(),
        chapter: kp.chapter.clone(),
        content: kp.content.clone(),
        mnemonic: kp.mnemonic.clone(),
        summary: kp.summary.clone(),
        source: kp.source.as_ref().map(|s| s.to_state()).unwrap_or_default(),
    }
}

fn load_domain_data(root: &Path) -> DomainData {
    match studyapp::list_subjects(root) {
        Ok(subjects) => DomainData {
            subjects,
            error: None,
        },
        Err(e) => DomainData {
            subjects: Vec::new(),
            error: Some(e),
        },
    }
}

/// Install a CJK font from `C:\Windows\Fonts` so Chinese renders.
fn install_fonts(ctx: &egui::Context) -> (Option<String>, Option<String>) {
    // (path, ttc face index)
    let candidates: [(&str, u32); 5] = [
        (r"C:\Windows\Fonts\msyh.ttc", 0),
        (r"C:\Windows\Fonts\msyhbd.ttc", 0),
        (r"C:\Windows\Fonts\simhei.ttf", 0),
        (r"C:\Windows\Fonts\Deng.ttf", 0),
        (r"C:\Windows\Fonts\simsun.ttc", 0),
    ];

    for (path, index) in candidates {
        match std::fs::read(path) {
            Ok(bytes) => {
                let mut fd = egui::FontData::from_owned(bytes);
                fd.index = index;
                let mut fonts = egui::FontDefinitions::default();
                fonts
                    .font_data
                    .insert("cjk".to_owned(), Arc::new(fd));
                fonts
                    .families
                    .entry(egui::FontFamily::Proportional)
                    .or_default()
                    .insert(0, "cjk".to_owned());
                fonts
                    .families
                    .entry(egui::FontFamily::Monospace)
                    .or_default()
                    .insert(0, "cjk".to_owned());
                ctx.set_fonts(fonts);
                return (Some(path.to_string()), None);
            }
            Err(_) => continue,
        }
    }

    (
        None,
        Some("警告：未找到 CJK 字体，中文可能无法显示。".to_string()),
    )
}

/// Deterministic Fisher–Yates using xorshift64.
fn shuffle<T>(v: &mut [T], seed: u64) {
    let mut s = seed | 1;
    for i in (1..v.len()).rev() {
        s ^= s << 13;
        s ^= s >> 7;
        s ^= s << 17;
        let j = (s % (i as u64 + 1)) as usize;
        v.swap(i, j);
    }
}

fn main() -> eframe::Result<()> {
    let native_options = eframe::NativeOptions {
        viewport: egui::ViewportBuilder::default()
            .with_title(APP_TITLE)
            .with_inner_size([1320.0, 880.0])
            .with_min_inner_size([900.0, 600.0]),
        ..Default::default()
    };

    eframe::run_native(
        APP_TITLE,
        native_options,
        Box::new(|cc| Ok(Box::new(App::new(cc)))),
    )
}
